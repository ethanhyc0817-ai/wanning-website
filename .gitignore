# macOS system files
.DS_Store
._*
.Spotlight-V100
.Trashes

# Original (uncompressed) asset backup — keep local, don't push
Assets-original/

# Local working folders — images here get renamed/copied to parent Assets/ folders
Assets/golf/choose/

# Videos — served via Cloudinary CDN, not stored in repo
*.mp4
*.MP4
*.mov
*.MOV
*.webm

# Stray HEIC files (replaced by .jpg versions)
*.HEIC
*.heic

# Stray temp files from compression
_compressed_*

# Original (pre-compression) backups of assets we keep around locally
*.original.jpg
*.original.jpeg
*.original.png

# Internal preview / draft HTML pages — never deploy
*-preview.html
*-preview-*.html

# Editor / IDE
.vscode/
.idea/
*.swp

# Logs & env
*.log
.env
.env.*

# Rendered social-post mockups (WeChat / 小红书 graphics). These are marketing
# outputs, not site content — when they sit in the repo root Vercel serves them
# publicly at surfchina.co/<name>. Four got committed by accident and were live
# for two days. Keep them out.
/*_post.html
/*_post.png
/*_post_*.html
/*_post_*.png

# Timestamped backups left beside the file they shadow (index.html.bak-YYYYMMDD,
# *.pdf.stale-*). They are superseded the moment the real file is regenerated.
*.bak-*
*.stale-*

# Rendered page previews of the brochure PDF — regenerable, never served.
/preview_v2/

# Build output of build_brochure.py. Regenerable, and when it sits in the repo
# root Vercel serves it publicly at surfchina.co/<name>. The client-facing
# brochures that pages actually link to live in Assets/brochures/.
/Surf_and_Golf_Hainan_Brochure.pdf
